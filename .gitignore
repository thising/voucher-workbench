!/openspec/specs/batch-merge/spec.md
!/app/Cargo.toml
!/app/Cargo.lock
!/app/LICENSE
!/app/API.md
!/app/TITLE-ORIENTATION.md
!/app/THIRD_PARTY_NOTICES.md
!/app/src/*.rs
!/app/tests/*.rs
!/app/examples/*.rs
!/app/web/index.html
!/app/web/app.js
!/app/web/style.css
!/app/web/generic.html
!/app/web/generic.js
!/app/web/generic.css
!/app/web/workbench.html
!/app/web/workbench.js
!/app/web/workbench.css
!/app/web/pdfjs/**/*
!/app/desktop/Cargo.toml
!/app/desktop/Cargo.lock
!/app/desktop/build.rs
!/app/desktop/package.json
!/app/desktop/package-lock.json
!/app/desktop/tauri.conf.json
!/app/desktop/src/*.rs
!/app/desktop/icons/*
!/app/desktop/assets/index.html
!/app/tools/cargo-local.sh
!/app/tools/dev.sh
!/app/tools/fetch-title-models.sh
!/app/tools/*.ps1
!/app/tools/smoke-windows-desktop.mjs
!/app/tools/test-workbench-ui.cjs
