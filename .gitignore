*
!*/
!/.gitignore
!/README.md
!/LICENSE
!/.github/workflows/windows.yml
!/tools/public-source.json
!/tools/prepare-source.py
!/docs/windows-release.md
!/openspec/specs/voucher-pdf/spec.md
!/openspec/specs/windows-distribution/spec.md
!/app/Cargo.toml
!/app/Cargo.lock
!/app/LICENSE
!/app/API.md
!/app/TITLE-ORIENTATION.md
!/app/THIRD_PARTY_NOTICES.md
!/app/src/*.rs
!/app/tests/*.rs
!/app/examples/*.rs
!/app/web/index.html
!/app/web/app.js
!/app/web/style.css
!/app/tools/cargo-local.sh
!/app/tools/dev.sh
!/app/tools/fetch-title-models.sh
!/app/tools/*.ps1
!/app/distribution/**/*
!/app/models/README.md
