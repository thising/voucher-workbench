!/app/models/title-ocr/LICENSE
!/app/models/title-ocr/dictionary.txt
!/app/models/title-ocr/det.yml
!/app/models/title-ocr/rec.yml

# Always exclude private/generated material, including accidental nested copies.
**/._*
**/.DS_Store
**/__pycache__/
**/*.onnx
/.local/
/.voucher-state/
/input/
/output/
/output_v2/
/memory/
/scripts/
/app/target/
/openspec/changes/
